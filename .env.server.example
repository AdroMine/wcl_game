# Game server environment (copy to .env.server or set in the host's dashboard). No real values here.

# Required in production (NODE_ENV=production): the server refuses to start without it.
# Use a long random string (at least 16 characters); never commit it.
# In development (NODE_ENV not production) it defaults to dev-admin-token-change-me.
ADMIN_TOKEN=

PORT=3001
NODE_ENV=development

# Public URL of the game (used for the QR code on the projector view).
PUBLIC_URL=http://localhost:5173

# Comma separated origins allowed to call the API from a browser. '*' works in development only.
ALLOWED_ORIGIN=http://localhost:5173

# Snapshot storage: 'file' (default) or 'supabase'. The file store is always written; Supabase is added on top.
SNAPSHOT_STORE=file
SNAPSHOT_DIR=./data

# Needed when SNAPSHOT_STORE=supabase. The secret (service role) key stays on the server.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: serve the built web app (and /config.json) from this directory (laptop "plan B").
STATIC_DIR=

# Optional: set to false when the server is NOT behind a proxy (then X-Forwarded-For is ignored for per-IP limits).
TRUST_PROXY=true
