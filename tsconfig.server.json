{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "shared/**/*.ts", "games/**/*.ts", "tools/**/*.ts", "tests/engine/**/*.ts", "tests/sim/**/*.ts", "tests/server/**/*.ts"],
  "exclude": ["server/stateStore.ts", "games/**/ui/**", "games/**/art.ts"]
}
